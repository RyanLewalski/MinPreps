# Copy this file to .env and adjust as needed. .env is gitignored.

# Local Postgres started by `npm run db:up` (see docker-compose.yml).
DATABASE_URL="postgresql://minpreps:minpreps@localhost:5432/minpreps?schema=public"

# Host port for the Postgres container. Change if 5432 is already in use,
# and update the port in DATABASE_URL to match.
DB_PORT=5432
